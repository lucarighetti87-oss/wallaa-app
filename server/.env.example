PORT=8787
# Legacy only. v4.0.5 does NOT embed this value in the iOS app and does not use it as user authentication.
# It may remain configured on Render during migration from v4.0.4.
APP_API_KEY=
ALLOWED_ORIGINS=https://wallaasafety.com,https://www.wallaasafety.com
MAX_CONTACTS=5

EMAIL_ENABLED=true
SMTP_HOST=authsmtp.securemail.pro
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=safety@wallaasafety.com
SMTP_PASS=INSERISCI_PASSWORD_SOLO_SUL_SERVER
SMTP_FROM=Wallaa Safety <safety@wallaasafety.com>

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
PGSSL=false

# Push iOS APNs — TestFlight / App Store use APNs production.
APNS_TEAM_ID=XXXXXXXXXX
APNS_KEY_ID=XXXXXXXXXX
APNS_BUNDLE_ID=it.wallaa.safebutton
APNS_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----

PUBLIC_BASE_URL=https://api.wallaasafety.com

# Wallaa Operating Center - receives a copy of real SOS alerts
OPERATING_CENTER_ENABLED=true
OPERATING_CENTER_NAME=Wallaa Operating Center
OPERATING_CENTER_EMAIL=safety@wallaasafety.com

PRIVACY_POLICY_VERSION=2026-09-07
TERMS_VERSION=2026-09-07
SAFETY_NOTICE_VERSION=2026-09-07
LOCATION_HISTORY_RETENTION_DAYS=30
ALERT_RETENTION_DAYS=30
HEARTBEAT_RETENTION_DAYS=30

# Wallaa Admin / Operating Console
ADMIN_BOOTSTRAP_EMAIL=admin@wallaasafety.com
ADMIN_BOOTSTRAP_PASSWORD=CHANGE_ME_WITH_A_LONG_RANDOM_PASSWORD
ADMIN_SESSION_HOURS=12

# Stripe Shop - NEVER commit real secret values
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_WALLAA_BOX=price_...
STRIPE_PRICE_WALLAA_PRO_MONTHLY=price_...
STRIPE_SHIPPING_COUNTRIES=IT
SHOP_BASE_URL=https://wallaasafety.com
